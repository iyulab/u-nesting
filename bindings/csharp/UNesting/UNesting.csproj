<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>UNesting</RootNamespace>
    <AssemblyName>UNesting</AssemblyName>

    <!-- NuGet Package Metadata -->
    <PackageId>UNesting</PackageId>
    <Version>0.16.0</Version>
    <Authors>iyulab</Authors>
    <Company>iyulab</Company>
    <Product>UNesting</Product>
    <Description>2D/3D spatial optimization engine for nesting and bin packing problems. High-performance Rust library with C# bindings.</Description>
    <PackageTags>nesting;bin-packing;optimization;geometry;2d;3d;cad;manufacturing</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/iyulab/U-Nesting</PackageProjectUrl>
    <RepositoryUrl>https://github.com/iyulab/U-Nesting</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>

    <!-- Build Configuration -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <!-- Trimmed and NativeAOT hosts: the analyzers fail the build on anything that
         would need reflection at run time. -->
    <IsAotCompatible>true</IsAotCompatible>
    <WarningsAsErrors>$(WarningsAsErrors);IL2026;IL2046;IL2057;IL2060;IL2067;IL2070;IL2072;IL2075;IL2087;IL2091;IL3050;IL3051</WarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="UNesting.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../README.md" Pack="true" PackagePath="\" />

    <!-- Native libraries, one per runtime identifier, placed under runtimes/ by the
         NuGet release workflow; its build matrix is the list of runtimes. -->
    <None Include="runtimes/**/*" Pack="true" PackagePath="runtimes/" />
  </ItemGroup>

</Project>
