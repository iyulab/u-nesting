<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <RootNamespace>UNesting.Tests</RootNamespace>

    <!-- What a trimmed or NativeAOT host runs with: any reflection-based JSON in the
         client throws here exactly as it would there. -->
    <JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>

    <!-- The native library from a `cargo build` with the ffi feature. A standalone clone
         builds into its own target/; inside a Cargo workspace it lands in the workspace's. -->
    <!-- A build told where to put its output (CARGO_TARGET_DIR, as the umbrella's
         release gate sets it) is the one to test: a library left in the repository's
         own target/ by an earlier build would otherwise be picked first. -->
    <UNestingNativeDir Condition="'$(UNestingNativeDir)' == '' and '$(CARGO_TARGET_DIR)' != '' and (Exists('$(CARGO_TARGET_DIR)/debug/u_nesting_ffi.dll') or Exists('$(CARGO_TARGET_DIR)/debug/libu_nesting_ffi.so') or Exists('$(CARGO_TARGET_DIR)/debug/libu_nesting_ffi.dylib'))">$(CARGO_TARGET_DIR)/debug</UNestingNativeDir>
    <UNestingNativeDir Condition="'$(UNestingNativeDir)' == '' and (Exists('$(MSBuildThisFileDirectory)../../../target/debug/u_nesting_ffi.dll') or Exists('$(MSBuildThisFileDirectory)../../../target/debug/libu_nesting_ffi.so') or Exists('$(MSBuildThisFileDirectory)../../../target/debug/libu_nesting_ffi.dylib'))">$(MSBuildThisFileDirectory)../../../target/debug</UNestingNativeDir>
    <UNestingNativeDir Condition="'$(UNestingNativeDir)' == ''">$(MSBuildThisFileDirectory)../../../../../target/debug</UNestingNativeDir>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1" />
  </ItemGroup>

  <ItemGroup>
    <None Include="$(UNestingNativeDir)/u_nesting_ffi.dll" Condition="Exists('$(UNestingNativeDir)/u_nesting_ffi.dll')"
          CopyToOutputDirectory="PreserveNewest" Visible="false" />
    <None Include="$(UNestingNativeDir)/libu_nesting_ffi.so" Condition="Exists('$(UNestingNativeDir)/libu_nesting_ffi.so')"
          CopyToOutputDirectory="PreserveNewest" Visible="false" />
    <None Include="$(UNestingNativeDir)/libu_nesting_ffi.dylib" Condition="Exists('$(UNestingNativeDir)/libu_nesting_ffi.dylib')"
          CopyToOutputDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <!-- The engine's request schemas: the keys the client writes are checked against them. -->
    <None Include="../../../docs/json-schema/request-*.schema.json" Link="schema/%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../UNesting/UNesting.csproj" />
  </ItemGroup>

</Project>
