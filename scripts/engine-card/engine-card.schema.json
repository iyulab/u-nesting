{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "engine-card.schema.json",
  "title": "Engine card",
  "description": "What a calculation or parser engine computes, where it is known to be right, what it costs, what it touches and how it is called — declared per operation, each claim pointing at the artifact that binds it to the implementation. Structure only: check-engine-card.py reads this file and adds the cross-field and file-existence rules.",
  "type": "object",
  "required": ["card_version", "engine", "surfaces", "operations"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "card_version": { "const": 1 },
    "engine": {
      "type": "object",
      "required": ["id", "summary", "version", "license"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" },
        "summary": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "license": { "type": "string", "minLength": 1 },
        "repository": { "type": "string" }
      }
    },
    "surfaces": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/surface" }
    },
    "errors": {
      "type": "object",
      "description": "The error vocabulary: listed here (codes), or pointed at where the implementation produces it (source) — at least one; the checker enforces that. With source, codes is an optional copy the repository keeps equal to the catalog.",
      "required": ["shape"],
      "additionalProperties": false,
      "properties": {
        "shape": { "type": "string", "minLength": 1 },
        "codes": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/error_code" }
        },
        "source": {
          "type": "object",
          "required": ["catalog", "test"],
          "additionalProperties": false,
          "properties": {
            "catalog": { "type": "string", "minLength": 1 },
            "test": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "operations": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/operation" }
    }
  },
  "$defs": {
    "surface": {
      "type": "object",
      "required": ["kind", "name", "package_version", "engine_version"],
      "additionalProperties": false,
      "properties": {
        "kind": { "enum": ["crate", "npm", "nuget", "pypi", "cli", "mcp", "c_abi", "other"] },
        "name": { "type": "string", "minLength": 1 },
        "package_version": { "type": "string", "minLength": 1 },
        "engine_version": { "type": "string", "minLength": 1 },
        "wasm": { "type": "boolean" },
        "error_shape": { "type": "string", "minLength": 1 },
        "note": { "type": "string" }
      }
    },
    "error_code": {
      "type": "object",
      "required": ["code", "meaning"],
      "additionalProperties": false,
      "properties": {
        "code": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "fields": { "type": "array", "items": { "type": "string" } },
        "meaning": { "type": "string", "minLength": 1 }
      }
    },
    "operation": {
      "type": "object",
      "required": ["id", "summary", "input", "output", "contract_test", "hints", "effects", "determinism", "validation", "performance"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "summary": { "type": "string", "minLength": 1 },
        "input": { "$ref": "#/$defs/contract" },
        "output": { "$ref": "#/$defs/contract" },
        "contract_test": { "type": "string", "minLength": 1 },
        "errors": { "type": "array", "items": { "type": "string" } },
        "hints": {
          "type": "object",
          "required": ["read_only", "destructive", "idempotent", "open_world"],
          "additionalProperties": false,
          "properties": {
            "read_only": { "type": "boolean" },
            "destructive": { "type": "boolean" },
            "idempotent": { "type": "boolean" },
            "open_world": { "type": "boolean" }
          }
        },
        "effects": {
          "type": "object",
          "required": ["filesystem", "network", "clock", "randomness"],
          "additionalProperties": false,
          "properties": {
            "filesystem": { "enum": ["none", "read", "write"] },
            "network": { "enum": ["none", "optional", "required"] },
            "network_off": { "type": "string" },
            "clock": { "enum": ["none", "deadline"] },
            "randomness": { "enum": ["none", "seeded", "unseeded"] },
            "note": { "type": "string" }
          }
        },
        "determinism": {
          "type": "object",
          "required": ["kind"],
          "additionalProperties": false,
          "properties": {
            "kind": { "enum": ["deterministic", "seeded", "time_bounded", "host_dependent", "nondeterministic"] },
            "test": { "type": "string" },
            "note": { "type": "string" },
            "cases": {
              "type": "array",
              "minItems": 1,
              "items": { "$ref": "#/$defs/determinism_case" }
            }
          }
        },
        "output_provenance": {
          "type": "object",
          "required": ["fields"],
          "additionalProperties": false,
          "properties": {
            "fields": { "type": "array", "minItems": 1, "items": { "type": "string" } },
            "note": { "type": "string" }
          }
        },
        "validation": {
          "type": "object",
          "required": ["status"],
          "additionalProperties": false,
          "properties": {
            "status": { "enum": ["validated", "partial", "none"] },
            "checks": { "type": "array", "items": { "$ref": "#/$defs/validation_check" } },
            "limits": { "type": "array", "items": { "type": "string", "minLength": 1 } }
          }
        },
        "performance": {
          "type": "object",
          "required": ["status"],
          "additionalProperties": false,
          "properties": {
            "status": { "enum": ["measured", "none"] },
            "complexity": { "type": "string" },
            "measurements": { "type": "array", "items": { "$ref": "#/$defs/measurement" } }
          }
        }
      }
    },
    "contract": {
      "type": "object",
      "required": ["schema"],
      "additionalProperties": false,
      "properties": {
        "schema": { "type": "string", "minLength": 1 },
        "freshness_test": { "type": "string", "minLength": 1 },
        "note": { "type": "string" }
      }
    },
    "determinism_case": {
      "type": "object",
      "description": "How the operation behaves when one input condition holds. randomness and clock default to the operation's effects; the operation-level kind is the worst case and applies when no case holds.",
      "required": ["when", "kind"],
      "additionalProperties": false,
      "properties": {
        "when": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["deterministic", "seeded", "time_bounded", "host_dependent", "nondeterministic"] },
        "randomness": { "enum": ["none", "seeded", "unseeded"] },
        "clock": { "enum": ["none", "deadline"] },
        "test": { "type": "string" },
        "note": { "type": "string" }
      }
    },
    "validation_check": {
      "type": "object",
      "required": ["claim", "reference_kind", "reference", "method", "test"],
      "additionalProperties": false,
      "properties": {
        "claim": { "type": "string", "minLength": 1 },
        "reference_kind": { "enum": ["standard", "literature", "reference_implementation", "dataset", "regulation"] },
        "reference": { "type": "string", "minLength": 1 },
        "method": { "type": "string", "minLength": 1 },
        "tolerance": { "type": "string" },
        "test": { "type": "string", "minLength": 1 }
      }
    },
    "measurement": {
      "type": "object",
      "required": ["instance", "metric", "value", "hardware", "reproduce", "measured_at"],
      "additionalProperties": false,
      "properties": {
        "instance": { "type": "string", "minLength": 1 },
        "metric": { "type": "string", "minLength": 1 },
        "value": { "type": "string", "minLength": 1 },
        "hardware": { "type": "string", "minLength": 1 },
        "reproduce": { "type": "string", "minLength": 1 },
        "measured_at": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" }
      }
    }
  }
}
